NEWS_DATABASE=news.db
NEWS_USER_AGENT=CurrentAffairsReader/1.0 (contact: you@example.com)
# Comma-separated source keys. Newspaper feeds are opt-in because their terms
# may restrict archival or commercial use.
NEWS_ENABLED_SOURCES=pib,indian_express_india,indian_express_upsc,times_of_india_top,times_of_india_india
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
NEWS_API_BASE_URL=http://127.0.0.1:5000
CONSOLIDATION_MODEL=sonar
CONSOLIDATION_MAX_CANDIDATES=250
CONSOLIDATION_REQUIRED_SOURCES=pib,rss,perplexity
